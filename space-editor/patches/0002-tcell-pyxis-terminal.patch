+//go:build pyxis
+
+package tcell
+
+// initialize uses the caller's terminal: Pyxis has no /dev/tty, so the
+// supplied standard streams are the terminal (docs/wip/terminal-ui.md).
+func (t *tScreen) initialize() error {
+	if t.tty == nil {
+		t.tty = &pyxisTty{}
+	}
+	return nil
+}
