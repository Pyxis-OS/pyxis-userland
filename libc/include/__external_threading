inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_yield()
{
  /* A weak processor hint under native preemption, with no forced reschedule
   * or fairness promise. This is not a successful POSIX scheduler operation. */
  __asm__ volatile("pause");
}

inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_sleep_for(const chrono::nanoseconds &duration)
{
  if (duration.count() <= 0) {
    return;
  }
  auto nanoseconds = duration.count();
  ::timespec time = {nanoseconds / 1000000000, static_cast<long>(nanoseconds % 1000000000)};
  if (::thrd_sleep(&time, nullptr)) {
    /* The void C++ hook cannot report unavailable authority or a failed sleep
     * as a successful elapsed duration. Use libc's retained clock grants. */
    ::_Exit(EXIT_FAILURE);
  }
}

