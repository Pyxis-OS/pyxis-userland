}

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_lock(__libcpp_recursive_mutex_t *mutex)
{
  return __libcpp_sync_integrity(::pthread_mutex_lock(mutex));
}

inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_recursive_mutex_trylock(__libcpp_recursive_mutex_t *mutex)
{
  int error = ::pthread_mutex_trylock(mutex);
  if (error == EBUSY) {
    return false;
  }
  __libcpp_sync_integrity(error);
  return true;
}

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_unlock(__libcpp_recursive_mutex_t *mutex)
