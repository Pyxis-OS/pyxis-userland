inline _LIBCPP_HIDE_FROM_ABI int __libcpp_execute_once(__libcpp_exec_once_flag *once,
    void (*initialize)(void))
{
  if (!initialize) {
    return EINVAL;
  }
  ::libc_once_frame frame;
  int run;
  int error = ::libc_once_begin(once, &frame, &run);
  if (error || !run) {
    return error;
  }
#if __has_feature(cxx_exceptions)
  try {
    initialize();
  } catch (...) {
    ::libc_once_abort(&frame);
    throw;
  }
#else
  initialize();
#endif
  ::libc_once_complete(&frame);
  return 0;
}

