/* Several runtime paths ignore lock errors. An unexpected retained-service
 * failure cannot let them continue with unprotected shared metadata. */
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_sync_integrity(int error)
{
  if (error) {
    ::_Exit(EXIT_FAILURE);
  }
  return 0;
}

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_init(__libcpp_recursive_mutex_t *mutex)
{
